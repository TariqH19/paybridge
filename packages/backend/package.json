{
  "name": "@paybridge/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:indexes": "tsx src/create-indexes.ts",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test src/products/product.schema.test.ts src/orders/order.schema.test.ts src/orders/order.service.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mongodb": "^6.19.0",
    "stripe": "^23.1.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
